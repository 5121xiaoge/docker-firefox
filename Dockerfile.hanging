# Single source of the pinned base image.  Written inline (not via ARG) so that
# Dependabot can propose new tags together with their digests.
FROM jlesage/firefox:v26.11.1@sha256:9b6f819004868a74a14fb1d82f4b2655a316cc99cf58c60bf41cbdb84bf8a08f

# Reuse the pinned upstream browser and GUI without rebuilding their toolchains.

# CJK fonts so Chinese/Japanese/Korean pages render without tofu boxes.
RUN add-pkg font-noto-cjk && fc-cache -f
COPY rootfs/ /
RUN \
    chmod 755 \
        /startapp.sh \
        /etc/cont-init.d/55-firefox.sh \
        /etc/cont-init.d/56-firefox-set-prefs-from-env.sh \
        /etc/cont-env.d/FF_PREF_NOTIF_BACKEND \
        /etc/cont-env.d/SUP_GROUP_IDS_INTERNAL_SND \
        /etc/services.d/app/params \
        /etc/services.d/app/kill \
        /etc/services.d/firefox-logrotate/run \
        /usr/share/firefox-tools/healthcheck.sh \
        /usr/share/firefox-tools/install-web-input.sh && \
    /usr/share/firefox-tools/install-web-input.sh && \
    ln -snf /config/machine-id /etc/machine-id

# Let the healthcheck also verify the web interface listener.
ENV FIREFOX_HEALTHCHECK_WEB=1
