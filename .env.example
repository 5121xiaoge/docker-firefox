# Optional: use the GHCR image published by your repository instead of a local build.
# Prefer a digest over a tag: docker buildx imagetools inspect <image:tag>
# FIREFOX_IMAGE=ghcr.io/your-account/your-repository@sha256:<digest>
# The pinned base image lives only in Dockerfile.hanging.
# 0.0.0.0 allows phones and other hosts; keep HTTPS and web authentication on then.
FIREFOX_BIND_IP=127.0.0.1
FIREFOX_PORT=5800
USER_ID=1000
GROUP_ID=1000
TZ=Asia/Shanghai
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=720
FF_OPEN_URL=
FF_KIOSK=0
FF_CUSTOM_ARGS=
SECURE_CONNECTION=0
WEB_AUTHENTICATION=0
# Web users are stored as bcrypt hashes in the volume, not in this file:
#   docker compose exec firefox webauth-user add <user>
# Resources (shared memory counts against the memory limit).
FIREFOX_MEM_LIMIT=2g
FIREFOX_SHM_SIZE=512m
