# Optional: use the GHCR image published by your repository instead of a local build.
# Prefer a digest over a tag: docker buildx imagetools inspect <image:tag>
# FIREFOX_IMAGE=ghcr.io/your-account/your-repository@sha256:<digest>
FIREFOX_BASE_IMAGE=jlesage/firefox:v26.09.1@sha256:302aa068dcfa46a2d248771c998f67377383554df8940252caef42b99c13eb65
FIREFOX_BIND_IP=127.0.0.1
FIREFOX_PORT=5800
USER_ID=1000
GROUP_ID=1000
TZ=Asia/Shanghai
DISPLAY_WIDTH=1280
DISPLAY_HEIGHT=720
FF_OPEN_URL=
FF_KIOSK=0
FF_CUSTOM_ARGS=
SECURE_CONNECTION=0
WEB_AUTHENTICATION=0
# Required when WEB_AUTHENTICATION=1.  Use single quotes so "$" is kept literally.
WEB_AUTHENTICATION_USERNAME=
WEB_AUTHENTICATION_PASSWORD=
# Resources (shared memory counts against the memory limit).
FIREFOX_MEM_LIMIT=2g
FIREFOX_SHM_SIZE=512m
